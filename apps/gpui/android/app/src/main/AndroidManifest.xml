<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="true" />
    <application android:name="tech.zseven.rish.gpui.RishGpuiApplication" android:label="Rish GPUI" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/RishTheme" android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <activity android:name="dev.gpui.mobile.GpuiActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="rish_gpui" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="tech.zseven.rish.gpui.ShellAvatarPickerActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/RishAvatarPickerTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rish_file_paths" />
        </provider>
        <service android:name="tech.zseven.rish.tasks.TaskForegroundService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <receiver android:name="tech.zseven.rish.tasks.TaskActionReceiver" android:exported="false" />
    </application>
</manifest>
